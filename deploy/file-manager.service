[Unit]
Description=文件管理系统
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/myTest/file-manager
ExecStart=/myTest/file-manager/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
